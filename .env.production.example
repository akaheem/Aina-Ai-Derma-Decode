# Frontend → backend wiring for PRODUCTION builds.
#
# After deploying the Vercel backend (see vercel-backend/README.md), copy this
# file to `.env.production` and set the URL to your deployed endpoint:
#
#   cp .env.production.example .env.production
#   # then edit the value below to your real Vercel URL
#
# Vite bakes VITE_* vars into the build at `npm run build`. This URL is public
# by design (the endpoint is protected by Firebase ID-token auth), so it's safe
# to commit. If unset, the app falls back to the Firebase callable (local dev).

VITE_ANALYZE_API_URL=https://YOUR-VERCEL-APP.vercel.app/api/analyze
